{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": [".claude/**"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"]
    },
    "apps/api": {
      "entry": ["test/**/*.test.ts", "test/utils/*Stub.ts"],
      "project": ["src/**", "test/**"],
      "ignoreDependencies": ["cloudflare"]
    },
    "apps/ping": {
      "entry": ["test/**/*.test.ts", "test/utils/workers.ts"],
      "project": ["src/**", "test/**", "scripts/**"],
      "ignoreDependencies": ["cloudflare"]
    },
    "apps/web": {
      "ignoreDependencies": ["tailwindcss"],
      "ignoreUnresolved": ["^\\./\\+types/"]
    },
    "apps/marketing": {
      "entry": ["scripts/*.ts"]
    }
  }
}
