---
import Section from './Section.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<Section>
  <div class='grid items-start gap-6 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-16'>
    <h2 class='max-w-md font-medium text-2xl text-fg-4 tracking-tight text-balance lg:text-3xl'>{title}</h2>
    <div class='flex min-w-0 flex-col gap-4 text-fg-2 text-pretty leading-relaxed [&_a]:text-fg-4 [&_a]:underline [&_a]:decoration-bg-4 [&_a]:underline-offset-2 [&_a:hover]:decoration-fg-2'>
      <slot />
    </div>
  </div>
</Section>
