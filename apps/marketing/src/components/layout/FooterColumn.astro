---
import Badge from '../ui/Badge.astro';

export interface Column {
  label: string;
  links: { label: string; href?: string }[];
}

interface Props {
  column: Column;
}

const { column } = Astro.props;
---

<nav aria-label={column.label} class='flex flex-col gap-2.5'>
  <span class='font-medium text-fg-4 text-sm'>{column.label}</span>
  {
    column.links.map((link) =>
      link.href ? (
        <a
          href={link.href}
          class='w-fit text-fg-2 text-sm transition-colors duration-150 hover:text-fg-4 active:text-fg-4'
        >
          {link.label}
        </a>
      ) : (
        <span class='flex w-fit items-center gap-2 text-fg-1 text-sm'>
          {link.label}
          <Badge>Soon</Badge>
        </span>
      )
    )
  }
</nav>
