---
import { Card } from '@buzzkit/ui/components/card';
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from '@buzzkit/ui/components/table';
import Cell from '../../components/compare/Cell.astro';
import PageHero from '../../components/layout/PageHero.astro';
import Section from '../../components/layout/Section.astro';
import ClosingCta from '../../components/sections/ClosingCta.astro';
import Faq from '../../components/sections/Faq.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import Site from '../../layouts/Site.astro';
import { comparisons, findComparison } from '../../lib/compare';
import { site } from '../../lib/site';
import { faqStructuredData } from '../../lib/structured-data';

export function getStaticPaths() {
  return comparisons.map((entry) => ({ params: { slug: entry.slug } }));
}

const comparison = findComparison(Astro.params.slug!);
---

<Site
  title={`BuzzKit vs ${comparison.competitor}`}
  description={comparison.summary}
  image={`/og/compare/${comparison.slug}.png`}
  markdownPath={`/compare/${comparison.slug}.md`}
>
  <script type='application/ld+json' is:inline set:html={JSON.stringify(faqStructuredData(comparison.faq))} slot='head' />
  <PageHero title={comparison.title} continuation={comparison.continuation} intro={comparison.intro}>
    <div class='mt-2 flex flex-wrap items-center gap-3'>
      <Button href={site.signupUrl}>Get Started</Button>
      <Button href={site.githubUrl} variant='elevated' external>
        <Icon name='IconGithub' class='size-4.5' />
        Star on GitHub
      </Button>
    </div>
  </PageHero>
  <Section>
    <Card>
      <Table className='table-fixed'>
        <TableHeader>
          <TableRow>
            <TableHead className='w-[40%]'>
              <span class='sr-only'>Capability</span>
            </TableHead>
            <TableHead className='whitespace-normal'>BuzzKit</TableHead>
            <TableHead className='whitespace-normal'>{comparison.competitor}</TableHead>
          </TableRow>
        </TableHeader>
        <TableBody>
          {
            comparison.groups.map((group) => (
              <>
                <TableRow className='bg-bg-a1/40 hover:bg-bg-a1/40'>
                  <TableCell colSpan={3} className='py-2 font-medium text-fg-2 text-xs'>
                    {group.group}
                  </TableCell>
                </TableRow>
                {group.rows.map((row) => (
                  <TableRow>
                    <TableCell className='whitespace-normal font-medium text-fg-4'>{row.capability}</TableCell>
                    <TableCell className='whitespace-normal text-fg-3'>
                      <Cell value={row.buzzkit} />
                    </TableCell>
                    <TableCell className='whitespace-normal text-fg-3'>
                      <Cell value={row.competitor} />
                    </TableCell>
                  </TableRow>
                ))}
              </>
            ))
          }
        </TableBody>
      </Table>
    </Card>
  </Section>
  <Section class='pt-0'>
    <div class='grid gap-10 md:grid-cols-2 lg:gap-16'>
      <div class='flex flex-col gap-4'>
        <h2 class='font-medium text-fg-4 text-xl leading-tighter'>Choose BuzzKit when</h2>
        <ul class='flex flex-col gap-3'>
          {
            comparison.chooseBuzzkit.map((point) => (
              <li class='flex items-start gap-2.5 text-fg-3 text-sm text-pretty'>
                <Icon name='IconCheckmark1' class='mt-0.5 size-4 shrink-0 rotate-[4deg] text-brand-4' />
                {point}
              </li>
            ))
          }
        </ul>
      </div>
      <div class='flex flex-col gap-4'>
        <h2 class='font-medium text-fg-4 text-xl leading-tighter'>Choose {comparison.competitor} when</h2>
        <ul class='flex flex-col gap-3'>
          {
            comparison.chooseCompetitor.map((point) => (
              <li class='flex items-start gap-2.5 text-fg-3 text-sm text-pretty'>
                <Icon name='IconCheckmark1' class='mt-0.5 size-4 shrink-0 rotate-[4deg] text-fg-2' />
                {point}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>
  <Faq items={comparison.faq} />
  <ClosingCta />
</Site>
