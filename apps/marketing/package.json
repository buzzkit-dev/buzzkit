{
  "name": "@buzzkit/marketing",
  "license": "AGPL-3.0-only",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run flags && astro dev --port 5181",
    "build": "bun run flags && bun run openapi && astro build && bun scripts/emit-agent-index.ts",
    "openapi": "bun run --cwd ../api openapi:emit",
    "preview": "astro preview --port 5181",
    "deploy": "bun run build && wrangler deploy",
    "check-types": "bun run cf-typegen && astro sync && tsc --noEmit",
    "cf-typegen": "wrangler types",
    "test": "bun run build && vitest run",
    "test:only": "vitest run",
    "flags": "bun scripts/sync-flags.ts"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@buzzkit/auth": "workspace:*",
    "@buzzkit/schema": "workspace:*",
    "@buzzkit/ui": "workspace:*",
    "@buzzkit/web": "workspace:*",
    "astro": "^7.2.10",
    "buzzkit": "workspace:*",
    "motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@buzzkit/api": "workspace:*",
    "@resvg/resvg-js": "^2.6.2",
    "@shuding/opentype.js": "1.4.0-beta.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "satori": "^0.33.4",
    "shiki": "^4.4.3",
    "typescript": "^7.0.2",
    "vitest": "~4.1.10",
    "wrangler": "^4.118.0"
  }
}
