# Copy to .dev.vars (git-ignored) for local development.

# Origin of the local buzzkit API dev server.
API_URL=http://localhost:8790

# Optional: the GitHub OAuth app's client id (public, not a secret). Its presence turns on the "Continue with
# GitHub" button; the API holds the same id plus the secret and runs the OAuth flow. Self-hosters can skip this.
GITHUB_CLIENT_ID=

# Local overrides of the production values in wrangler.jsonc (wrangler dev applies .dev.vars over vars).
ENVIRONMENT=development
