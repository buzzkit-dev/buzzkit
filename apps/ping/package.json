{
  "name": "@buzzkit/ping",
  "license": "AGPL-3.0-only",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --local --ip 0.0.0.0 --persist-to=../../.wrangler/state --port 8792",
    "start": "wrangler dev",
    "cf-typegen": "[ -f .dev.vars ] || cp .dev.vars.example .dev.vars; wrangler types",
    "check-types": "bun run cf-typegen && tsc --noEmit && tsc -p test --noEmit && tsc -p scripts --noEmit",
    "test": "NODE_OPTIONS=--no-warnings=ExperimentalWarning vitest run test/api test/device test/utils",
    "test:e2e": "bun scripts/test.ts test/e2e",
    "test:only": "NODE_OPTIONS=--no-warnings=ExperimentalWarning vitest run"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "~4.1.10",
    "wrangler": "^4.118.0"
  },
  "dependencies": {
    "buzzkit": "workspace:*",
    "elysia": "^1.4.29"
  }
}
