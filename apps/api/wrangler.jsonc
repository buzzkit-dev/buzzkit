{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "buzzkit-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true
  },

  "workers_dev": true,
  "preview_urls": true,

  // Non-secret runtime config; override per environment at deploy time.
  // SQIDS_ALPHABET is a shuffled alphabet so IDs aren't trivially enumerable —
  // hosted/production deployments MUST override it (wrangler secret).
  "vars": {
    "ENVIRONMENT": "development",
    "SQIDS_ALPHABET": "kdiEK9YyRrDlM4pnPXWQmL2wNZzeUxIqSHVvTGtjb0aJFuh3s618Bf5cCgAO7o",
    "DASHBOARD_URL": "http://localhost:5180",
    "EMAIL_FROM": "invites@buzzkit.dev",
    // Head-sampling ratio for traces (0..1); tail sampling always keeps error traces.
    "TRACE_SAMPLE_RATIO": "1"
  },

  // Cloudflare Email Service. `remote: true` sends real email even in local
  // dev; the EMAIL_FROM domain must be onboarded to Email Sending first.
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true
    }
  ],

  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "your-hyperdrive-id",
      "localConnectionString": "postgresql://postgres:postgres@localhost:5460/buzzkit"
    }
  ],

  // AUTH_CACHE: resolved dashboard sessions (5 min) and API keys (60s, purged on revoke).
  // PROVIDER_CACHE: short-lived provider tokens (APNs JWT, FCM OAuth).
  "kv_namespaces": [
    {
      "binding": "AUTH_CACHE",
      "id": "your-auth-cache-kv-id"
    },
    {
      "binding": "PROVIDER_CACHE",
      "id": "your-provider-cache-kv-id"
    }
  ],

  "queues": {
    "producers": [{ "queue": "buzzkit-deliveries", "binding": "DELIVERIES" }],
    "consumers": [
      {
        "queue": "buzzkit-deliveries",
        "max_batch_size": 100,
        "max_batch_timeout": 1,
        // Each invocation holds ≤2 DB connections; 40 × 2 stays well inside Hyperdrive's pool
        "max_concurrency": 40,
        // Delivery retries are scheduled in-code (persisted next_attempt_at +
        // delayed re-enqueue); this caps runaway redelivery of crashing jobs
        "max_retries": 8,
        "dead_letter_queue": "buzzkit-deliveries-dlq"
      }
    ]
  },

  "triggers": {
    // Delivery reconciliation: due retries, lost enqueues, expiries, stalled fan-outs
    "crons": ["*/5 * * * *"]
  }
}
