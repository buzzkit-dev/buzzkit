{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buzzkit-api",
  "account_id": "e8563b02f2bf2b6a136f2781445a486f",
  "routes": [{ "pattern": "api.buzzkit.dev", "custom_domain": true }],
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true
  },

  "workers_dev": true,
  "preview_urls": true,

  "vars": {
    "ENVIRONMENT": "production",
    "WORKFLOW_TIME_SCALE": "1",
    "DASHBOARD_URL": "https://buzzkit.dev",
    "TRACE_SAMPLE_RATIO": "1",
    "TINYBIRD_URL": "https://api.us-east.aws.tinybird.co"
  },

  // Cloudflare Email Service. `remote: true` sends real email even in local
  // dev; the sender domain (libs/email.ts) must be onboarded to Email Sending first.
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true
    }
  ],

  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "9b6e6bad580a458d8079caeb73bd2f58",
      "localConnectionString": "postgresql://postgres:postgres@localhost:5460/buzzkit"
    }
  ],

  // AUTH_CACHE: resolved dashboard sessions (5 min) and API keys (60s, purged on revoke).
  // PROVIDER_CACHE: short-lived provider tokens (APNs JWT, FCM OAuth).
  "kv_namespaces": [
    {
      "binding": "AUTH_CACHE",
      "id": "db4ac8ad2808400eb5cebfd1a86e9dcd"
    },
    {
      "binding": "PROVIDER_CACHE",
      "id": "a5e8761f3c154d63bdc7ad831492b092"
    },
    {
      "binding": "ENGINE_DEFS",
      "id": "82b773dd78654313a208b6f882b9e01d"
    }
  ],

  "queues": {
    "producers": [
      { "queue": "buzzkit-deliveries", "binding": "DELIVERIES" },
      { "queue": "buzzkit-events", "binding": "EVENTS" },
      { "queue": "buzzkit-webhooks", "binding": "WEBHOOKS" }
    ],
    "consumers": [
      {
        "queue": "buzzkit-deliveries",
        "max_batch_size": 100,
        "max_batch_timeout": 1,
        "max_concurrency": 40,
        "max_retries": 8,
        "dead_letter_queue": "buzzkit-deliveries-dlq"
      },
      {
        "queue": "buzzkit-events",
        "max_batch_size": 100,
        "max_batch_timeout": 5,
        "max_concurrency": 20,
        "max_retries": 10,
        "dead_letter_queue": "buzzkit-events-dlq"
      },
      {
        "queue": "buzzkit-events-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_concurrency": 1,
        "max_retries": 100,
        "dead_letter_queue": "buzzkit-events"
      },
      {
        "queue": "buzzkit-webhooks",
        "max_batch_size": 20,
        "max_batch_timeout": 2,
        "max_concurrency": 20,
        "max_retries": 5,
        "dead_letter_queue": "buzzkit-webhooks-dlq"
      },
      {
        "queue": "buzzkit-deliveries-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_concurrency": 1,
        "max_retries": 3
      },
      {
        "queue": "buzzkit-webhooks-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_concurrency": 1,
        "max_retries": 3
      }
    ]
  },

  "durable_objects": {
    "bindings": [{ "name": "SUBSCRIBER_ACTOR", "class_name": "SubscriberActor" }]
  },

  "workflows": [{ "name": "buzzkit-workflows", "binding": "ENGINE", "class_name": "EngineWorkflow" }],

  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SubscriberActor"] }],

  "triggers": {
    "crons": ["* * * * *", "*/5 * * * *"]
  }
}
