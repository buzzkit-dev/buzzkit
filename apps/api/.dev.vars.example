# Auth
BETTER_AUTH_URL=http://localhost:8790/v1/auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32

# Master key that wraps every credential's data key, 32 random bytes base64 (openssl rand -base64 32). To rotate, add
# the next version (_V2, _V3, ...) and deploy: new uploads seal under the highest version, the scheduler re-wraps older
# rows to it, and once none are left the old version can be removed. Versions must be contiguous from 1.
CREDENTIAL_MASTER_KEY_V1=generate-with-openssl-rand-base64-32


# Shuffled Sqids alphabet (all 62 of 0-9a-zA-Z in a random order) so public ids are not enumerable. Generate one per
# deployment and never change it afterwards: ids are derived from it.
SQIDS_ALPHABET=

# Optional: GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional telemetry. Traces: OTEL_EXPORTER_OTLP_ENDPOINT wins (local: `bun jaeger` then http://localhost:4318),
# else Axiom when token + dataset are set, else dropped. Logs always print to console; Axiom when configured.
OTEL_EXPORTER_OTLP_ENDPOINT=
AXIOM_API_TOKEN=
AXIOM_LOGS_DATASET=
AXIOM_TRACES_DATASET=


# Tinybird: the event log (docs/engine.md). Locally `bun db:up` starts Tinybird Local next to Postgres and
# `bun run --cwd packages/tinybird token` prints its workspace token; deployed, a workspace admin token
# (ingest, queries and short-lived dashboard JWTs). TINYBIRD_URL is a wrangler var (http://localhost:7181 locally).
TINYBIRD_TOKEN=

# Local overrides of the production values in wrangler.jsonc (wrangler dev applies .dev.vars over vars).
ENVIRONMENT=development
DASHBOARD_URL=http://localhost:5180
TINYBIRD_URL=http://localhost:7181

# Simulated API latency for local loading work: "500-1500" for a random delay in that range, or a single number.
# Ignored unless ENVIRONMENT=development. Leave empty for instant responses.
SIMULATED_LATENCY_MS=
