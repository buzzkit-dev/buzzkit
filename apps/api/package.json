{
  "name": "@buzzkit/api",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./contract": {
      "types": "./.types/modules/contract.d.ts",
      "default": "./src/modules/contract.ts"
    },
    "./*": {
      "types": "./.types/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --test-scheduled --local --ip 0.0.0.0 --persist-to=../../.wrangler/state --port 8790",
    "start": "wrangler dev --test-scheduled",
    "test": "bun scripts/test.ts",
    "cf-typegen": "[ -f .dev.vars ] || cp .dev.vars.example .dev.vars; wrangler types",
    "check-types": "bun run cf-typegen && tsc --noEmit && tsc -p test --noEmit",
    "types:emit": "rm -rf .types && tsc --noEmit false --emitDeclarationOnly --declaration --rootDir src --outDir .types",
    "jaeger": "docker run -d --name buzzkit-jaeger -p 16686:16686 -p 4318:4318 jaegertracing/all-in-one:latest",
    "coverage": "NODE_OPTIONS=--no-warnings=ExperimentalWarning vitest run test/actor test/engine test/api test/libs test/queue test/utils test/providers test/packages --coverage.enabled --coverage.include=src/engine/** --coverage.include=src/providers/**",
    "test:only": "NODE_OPTIONS=--no-warnings=ExperimentalWarning vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^7.0.2",
    "vitest": "~4.1.10",
    "wrangler": "^4.118.0"
  },
  "dependencies": {
    "@buzzkit/auth": "workspace:*",
    "@buzzkit/database": "workspace:*",
    "@buzzkit/observability": "workspace:*",
    "@buzzkit/schema": "workspace:*",
    "@buzzkit/tinybird": "workspace:*",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "^1.4.15",
    "@kubiks/otel-better-auth": "^2.0.2",
    "@kubiks/otel-drizzle": "^2.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@sinclair/typebox": "^0.34.52",
    "agents": "^0.21.0",
    "better-auth": "1.6.25",
    "buzzkit": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29",
    "sqids": "^0.3.0"
  }
}
