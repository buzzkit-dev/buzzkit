    "@buzzkit/marketing",
    "@buzzkit/docs",
    "@buzzkit/schema",
    "@buzzkit/database",
    "@buzzkit/auth",
    "@buzzkit/eden",
    "@buzzkit/observability",
    "@buzzkit/tinybird",
    "@buzzkit/ui"
  ]
}
